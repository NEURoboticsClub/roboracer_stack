<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.0.0</version>
  <description>Launch files that bring up the car and the AutoDRIVE sim stack</description>
  <maintainer email="dheeshik@gmail.com">dheeshik</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>

  <!-- Everything the launch files bring up. Declared so that a missing piece
       fails at build/rosdep time with a name, instead of at car-side launch
       time with "package not found" while the track is booked. -->
  <exec_depend>sick_scan_xd</exec_depend>
  <exec_depend>planner</exec_depend>
  <exec_depend>vesc_driver</exec_depend>
  <exec_depend>vesc_ackermann</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
